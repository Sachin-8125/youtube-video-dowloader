{
  "manifest_version": 3,
  "name": "YouTube Downloader",
  "version": "1.0.0",
  "description": "Download the current YouTube video using a local yt-dlp install.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "Download with yt-dlp" },
  "background": { "service_worker": "background.js" }
}
